<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{orgName}} – Wochenansicht</title>

  <!-- FullCalendar v6 -->
  <!-- FullCalendar v6 (lokal aus dem npm-Paket eingebettet, siehe PrintTemplateService.getFullCalendarScript –
       Version identisch zum Frontend, siehe package.json "fullcalendar") -->
  <script>{{{fullCalendarScript}}}</script>

  <style>
    /* ─── Design-Tokens (identisch mit Monatsansicht) ────────────── */
    :root {
      --fc-border-color:       #d1d9e0;
      --fc-page-bg-color:      #ffffff;
      --fc-neutral-bg-color:   #f4f6f8;
      --fc-today-bg-color:     #fffbe6;
      --fc-event-border-color: transparent;
      --fc-event-text-color: #1a252f;

      --text:  #1f2937;
      --muted: #6b7280;
      --accent:#1a6fdb;

      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body { background: #dde1e7; color: var(--text); }

    /* ─── Toolbar ────────────────────────────────────────────────── */
    .toolbar {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      max-width: 297mm;
      margin: 14px auto 0;
      padding: 0 14px;
    }
    .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 18px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn:hover { background: #155bbf; }

    /* ─── A4 Quer Seite ──────────────────────────────────────────── */
    .page {
      width:  297mm;
      height: 210mm;
      margin: 14px auto;
      background: #fff;
      box-shadow: 0 8px 32px rgba(0,0,0,.14);
      padding: 7mm;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 2.5mm;
      overflow: hidden;
    }

    /* ─── Kopfzeile ─────────────────────────────────────────────── */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 2.5mm;
    }
    .page-header h1 {
      font-size: 15pt;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -.2px;
    }
    .page-header .sub {
      font-size: 8.5pt;
      color: var(--muted);
      margin-top: 1.5mm;
    }
    .logo-box {
      width: 30mm;
      height: 18mm;
      border: 1.5px dashed #9aa4b2;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #9aa4b2;
      font-size: 8pt;
      text-align: center;
      flex-shrink: 0;
      overflow: hidden;
    }
    .logo-box img { max-width: 100%; max-height: 100%; object-fit: contain; }

    /* ─── Kalender-Wrapper ───────────────────────────────────────── */
    #calendar-wrap {
      min-height: 0;
      overflow: hidden;
      position: relative;
    }
    #calendar {
      height: 100%;
    }

    /* ─── FullCalendar Overrides — timeGridWeek ──────────────────── */

    /* FC-Toolbar verstecken */
    .fc .fc-toolbar { display: none !important; }

    /* Scroll-Container fixieren (kein internes Scrollen) */
    .fc .fc-timegrid-body,
    .fc .fc-scroller,
    .fc .fc-scroller-harness,
    .fc .fc-scroller-liquid-absolute {
      overflow: hidden !important;
      height: 100% !important;
    }

    /* Spaltenkopf (Wochentage) */
    .fc .fc-col-header-cell {
      background: #f0f4f8;
      border-color: var(--fc-border-color) !important;
      padding: 1mm 0;
    }
    .fc .fc-col-header-cell-cushion {
      font-size: 8pt;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      padding: 1mm 0;
      display: block;
      text-align: center;
    }

    /* Zeitachse links */
    .fc .fc-timegrid-axis {
      width: 10mm !important;
      padding: 0 !important;
    }
    .fc .fc-timegrid-slot-label-cushion {
      font-size: 6.5pt;
      color: var(--muted);
      padding: 0 1.5mm 0 0;
      text-align: right;
      white-space: nowrap;
    }

    /* Zeitslots */
    .fc .fc-timegrid-slot {
      height: auto !important;
    }
    .fc .fc-timegrid-slot-lane {
      border-color: #e8edf2 !important;
    }
    /* Volle Stunde etwas prominenter */
    .fc .fc-timegrid-slot-label {
      border-color: #d1d9e0 !important;
    }

    /* Heute-Spalte */
    .fc .fc-day-today {
      background: var(--fc-today-bg-color) !important;
    }
    .fc .fc-day-today .fc-col-header-cell-cushion {
      color: var(--accent);
    }

    /* Events */
    .fc .fc-timegrid-event {
      border-radius: 5px !important;
      border: none !important;
      border-left: 3px solid transparent !important;
      padding: 1.5px 3px !important;
      font-size: 7pt !important;
      line-height: 1.3 !important;
      font-weight: 500;
      box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }
    .fc .fc-event-title {
      font-weight: 600;
      white-space: normal;   /* lange Titel umbrechen statt hart abzuschneiden */
      overflow: hidden;
    }
    .fc .fc-event-time  { font-size: 6.5pt; opacity: .8; }

    /* Now-Indicator */
    .fc .fc-timegrid-now-indicator-line {
      border-color: var(--accent) !important;
      border-width: 1.5px !important;
    }
    .fc .fc-timegrid-now-indicator-arrow {
      border-top-color: var(--accent) !important;
      border-bottom-color: var(--accent) !important;
    }

    /* Gitter */
    .fc-theme-standard td,
    .fc-theme-standard th { border-color: #d1d9e0 !important; }

    /* ─── Footer ─────────────────────────────────────────────────── */
    .page-footer {
      border-top: 1px solid var(--fc-border-color);
      padding-top: 2mm;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
    }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 3mm;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 1.5mm;
      border: 1px solid var(--fc-border-color);
      border-radius: 5px;
      padding: 1mm 2mm;
      font-size: 7.5pt;
      flex: 1;
      min-width: 0;
    }
    .swatch {
      width: 8mm;
      height: 4mm;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .info-line {
      display: flex;
      justify-content: space-between;
      font-size: 7.5pt;
      color: var(--muted);
    }
    .info-line strong { color: var(--text); font-weight: 600; }

    /* ─── Druck ──────────────────────────────────────────────────── */
    @page { size: A4 landscape; margin: 0; }

    @media print {
      body    { background: white; }
      .toolbar { display: none; }
      .page {
        width: 297mm;
        height: 210mm;
        margin: 0;
        box-shadow: none;
        padding: 7mm;
      }
      .fc .fc-scroller,
      .fc .fc-scroller-harness { overflow: hidden !important; }
    }
  </style>
</head>
<body>

  <div class="toolbar">
    <button class="btn" onclick="window.print()">⬇ Als PDF drucken</button>
  </div>

  <main class="page">

    <!-- Kopfzeile -->
    <header class="page-header">
      <div>
        <h1 id="pageTitle">{{orgName}}</h1>
        <p class="sub" id="pageSubtitle">Wochenansicht · DIN A4 quer · FullCalendar v6</p>
      </div>
      <div class="logo-box">
        {{#if logoUrl}}<img src="{{logoUrl}}" alt="Logo" />{{else}}Logo<br>Platzhalter{{/if}}
      </div>
    </header>

    <!-- Kalender -->
    <div id="calendar-wrap">
      <div id="calendar"></div>
    </div>

    <!-- Footer -->
    <footer class="page-footer">
      <div class="legend">
        {{#each rooms}}
        <div class="legend-item"><span class="swatch" style="background:{{this.color}};"></span>{{this.title}}</div>
        {{/each}}
      </div>
      <div class="info-line">
        <span>ingrid-manager.de</span>
        <span><strong>Druckdatum:</strong> {{printedAt}}</span>
      </div>
    </footer>
  </main>

  <script>
  document.addEventListener('DOMContentLoaded', function () {

    // ── Termine (vom Backend eingesetzt) ───────────────────────────
    const events = {{{eventsJson}}};

    // ── FullCalendar ──────────────────────────────────────────────
    const calEl = document.getElementById('calendar');

    const calendar = new FullCalendar.Calendar(calEl, {
      locale:         'de',
      initialView:    'timeGridWeek',
      initialDate:    '{{initialDateIso}}',
      firstDay:       1,              // Montag
      headerToolbar:  false,

      // Kernzeit 09 – 21 Uhr (wie in der Original-Vorlage)
      slotMinTime:    '09:00:00',
      slotMaxTime:    '21:00:00',

      // Slotgröße: 30 min; nur volle Stunden beschriften
      slotDuration:       '00:30:00',
      slotLabelInterval:  '01:00:00',
      slotLabelFormat:    { hour: '2-digit', minute: '2-digit', hour12: false },

      // Tageszeit-Bereiche ausblenden
      allDaySlot:     true,
      allDayText:     'Ganztägig',
      nowIndicator:   true,

      // Wochentag + Datum im Spaltenkopf
      dayHeaderFormat: { weekday: 'short', day: '2-digit', month: '2-digit' },

      events: events,
      height: '100%',
      expandRows: true,       // Zeilen auf verfügbare Höhe strecken

      // Raumfarbe je Termin (beliebig viele Räume/Farben statt fixer ev-room1..5-Klassen)
      eventDidMount: function (info) {
        const color = info.event.extendedProps.roomColor;
        if (color) {
          info.el.style.backgroundColor = color + '33';
          info.el.style.borderLeftColor = color;
          info.el.style.color = '#1a252f';
        }
      },
    });

    calendar.render();

    // Überschrift dynamisch mit KW befüllen
    const startDate = calendar.view.currentStart;
    const endDate   = new Date(calendar.view.currentEnd);
    endDate.setDate(endDate.getDate() - 1);

    const fmt = d => d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
    const kw  = Math.ceil(
      ((startDate - new Date(startDate.getFullYear(), 0, 1)) / 86400000 +
        new Date(startDate.getFullYear(), 0, 1).getDay() + 1) / 7
    );

    document.getElementById('pageTitle').textContent =
      `{{orgName}} – KW ${kw} · ${startDate.getFullYear()}`;
    document.getElementById('pageSubtitle').textContent =
      `${fmt(startDate)} – ${fmt(endDate)} · Wochenansicht · DIN A4 quer`;
  });
  </script>
</body>
</html>
