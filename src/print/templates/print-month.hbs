<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{orgName}} – {{rangeLabel}}</title>

  <!-- FullCalendar v6 -->
  <!-- FullCalendar v6 (lokal aus dem npm-Paket eingebettet, siehe PrintTemplateService.getFullCalendarScript –
       Version identisch zum Frontend, siehe package.json "fullcalendar") -->
  <script>{{{fullCalendarScript}}}</script>

  <style>
    /* ─── Design-Tokens ─────────────────────────────────────────── */
    :root {
      --fc-border-color:        #d1d9e0;
      --fc-page-bg-color:       #ffffff;
      --fc-neutral-bg-color:    #f4f6f8;
      --fc-today-bg-color:      #ffffff;
      --fc-event-border-color:  transparent;
      --fc-event-text-color: #1a252f;

      --text:  #1f2937;
      --muted: #6b7280;
      --accent:#1a6fdb;

      --page-w: 297mm;
      --page-h: 210mm;
      --margin: 2mm;

      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    /* ─── Reset / Base ──────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #dde1e7;
      color: var(--text);
    }

    /* ─── Toolbar (nur Bildschirm) ──────────────────────────────── */
    .toolbar {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      max-width: var(--page-w);
      margin: 14px auto 0;
      padding: 0 14px;
    }
    .btn {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 18px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: .3px;
    }
    .btn:hover { background: #155bbf; }

    /* ─── Seite (A4 quer) ───────────────────────────────────────── */
    .page {
      width:  var(--page-w);
      height: var(--page-h);
      margin: 14px auto;
      background: #fff;
      box-shadow: 0 8px 32px rgba(0,0,0,.14);
      /* Schmale Ränder, besonders oben (auf Kundenwunsch) — mehr Platz
         für den eigentlichen Kalender. */
      padding: 2mm 4mm 3mm;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 1.5mm;
      overflow: hidden;
    }

    /* ─── Kopfzeile ─────────────────────────────────────────────── */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 1mm;
    }
    .page-header h1 {
      font-size: 15pt;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -.2px;
    }
    .page-header .sub {
      font-size: 8.5pt;
      color: var(--muted);
      margin-top: 1.5mm;
    }
    /* Logo vorerst deaktiviert (auf Kundenwunsch) — .logo-box-Regel und
       das zugehörige Markup weiter unten bewusst entfernt, nicht nur
       versteckt. Bei Bedarf einfach wieder ergänzen: ein <div class="logo-box">
       im <header>. */

    /* ─── Kalender-Wrapper ───────────────────────────────────────── */
    #calendar-wrap {
      min-height: 0;
      overflow: hidden;
      height: 100%;
    }
    #calendar { height: 100%; }

    /* ─── FullCalendar Overrides ─────────────────────────────────── */

    /* Toolbar / Navigations-Leiste komplett ausblenden */
    .fc .fc-toolbar { display: none !important; }

    /* Wochentag-Kopfzeile */
    .fc .fc-col-header-cell {
      background: #f0f4f8;
      border-color: var(--fc-border-color) !important;
      padding: 1.5mm 0;
    }
    .fc .fc-col-header-cell-cushion {
      font-size: 8.5pt;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      padding: 0;
    }

    /* Tages-Zellen */
    .fc .fc-daygrid-day {
      border-color: var(--fc-border-color) !important;
    }
    .fc .fc-daygrid-day-frame {
      padding: 1mm !important;
      height: 100% !important;
      overflow: hidden !important;
    }

    /* Tageszahl */
    .fc .fc-daygrid-day-number {
      font-size: 8pt;
      font-weight: 700;
      padding: 0 0 .5mm 0;
      color: var(--text);
      text-decoration: none;
      line-height: 1.2;
    }
    .fc .fc-day-other .fc-daygrid-day-number { color: #b0b8c4; }

    /* Heutiger Tag */
    .fc .fc-day-today { background: var(--fc-today-bg-color) !important; }
    .fc .fc-day-today .fc-daygrid-day-number {
      color: var(--text);
      font-size: 8.5pt;
    }

    /* Events */
    .fc .fc-event {
      border-radius: 4px !important;
      border: none !important;
      padding: 1px 3px !important;
      font-size: 7.5pt !important;
      line-height: 1.25 !important;
      font-weight: 500;
      margin: 1px 0 !important;
      cursor: default;
    }
    .fc .fc-event-title { white-space: normal; overflow: hidden; }
    .fc .fc-event-time  { display: none; }      /* Zeit wird im Titel gezeigt */
    .fc .fc-daygrid-event-dot { display: none; }

    /* "+N weitere"-Link dezent stylen (bleibt sichtbar!) */
    .fc .fc-more-link {
      font-size: 6.8pt;
      color: var(--muted);
      font-style: italic;
    }

    /* Gitter-Linien schärfer */
    .fc-theme-standard td, .fc-theme-standard th { border-color: #d1d9e0 !important; }

    /* ─── Footer ─────────────────────────────────────────────────── */
    .page-footer {
      border-top: 1px solid var(--fc-border-color);
      padding-top: 2mm;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 2mm;
    }
    .legend-item {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 5px;
      padding: 1.3mm 3mm;
      font-size: 7.5pt;
      font-weight: 600;
      flex: 1;
      min-width: 0;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .info-line {
      display: flex;
      justify-content: space-between;
      font-size: 7.5pt;
      color: var(--muted);
    }
    .info-line strong { color: var(--text); font-weight: 600; }

    /* ─── Druck ──────────────────────────────────────────────────── */
    @page { size: A4 landscape; margin: 0; }

    @media print {
      body    { background: white; }
      .toolbar { display: none; }
      .page {
        width: 297mm;
        height: 210mm;
        margin: 0;
        box-shadow: none;
        padding: 2mm 4mm 3mm;
      }
      .fc .fc-event-title { white-space: normal !important; }
    }
  </style>
</head>
<body>

  <!-- Toolbar -->
  <div class="toolbar no-print">
    <button class="btn" onclick="window.print()">⬇ Als PDF drucken</button>
  </div>

  <!-- A4-Seite -->
  <main class="page">

    <!-- Kopfzeile -->
    <header class="page-header">
      <div>
        <h1>{{orgName}} – Monat {{rangeLabel}}</h1>
        <p class="sub">Monatsansicht · DIN A4 quer · FullCalendar v6</p>
      </div>
    </header>

    <!-- Kalender -->
    <div id="calendar-wrap">
      <div id="calendar"></div>
    </div>

    <!-- Footer -->
    <footer class="page-footer">
      <div class="legend">
        {{#each rooms}}
        <div class="legend-item" style="background:{{this.color}}; color:{{this.textColor}};">{{this.title}}</div>
        {{/each}}
      </div>
      <div class="info-line">
        <span>ingrid-manager.de{{#if frontendDomain}} | {{frontendDomain}}{{/if}}</span>
        <span><strong>Druckdatum:</strong> {{printedAt}}</span>
      </div>
    </footer>
  </main>

  <script>
  document.addEventListener('DOMContentLoaded', function () {

    // ── Termine (vom Backend eingesetzt) ────────────────────────────
    // Format: { title: 'HH:mm Titel' | 'Titel' (ganztägig), start: 'YYYY-MM-DD', roomColor }
    const events = {{{eventsJson}}};

    // ── FullCalendar initialisieren ───────────────────────────────
    const calEl   = document.getElementById('calendar');

    const calendar = new FullCalendar.Calendar(calEl, {
      locale:          'de',
      initialView:     'dayGridMonth',
      initialDate:     '{{initialDateIso}}',
      firstDay:        1,          // Montag
      fixedWeekCount:  true,       // immer 6 Zeilen → konsistent auf A4
      showNonCurrentDates: true,
      headerToolbar:   false,      // eigene Kopfzeile; FC-Toolbar versteckt
      // WICHTIG: nicht auf `false` setzen! Bei vielen Terminen an einem Tag
      // würde die Zeile sonst unbegrenzt wachsen und ggf. über die A4-Seite
      // hinausragen (mit echten Testdaten nachgewiesen). `true` lässt
      // FullCalendar automatisch anhand der verfügbaren Zellenhöhe begrenzen
      // und einen "+N weitere"-Hinweis einblenden.
      dayMaxEvents:    true,
      eventDisplay:    'block',
      events:          events,
      // WICHTIG: Höhe direkt und synchron auf '100%' setzen (wie in der
      // Wochenvorlage), NICHT über 'auto' + nachträgliches JS-Resize.
      // Mit `dayMaxEvents:true` muss FullCalendar die verfügbare
      // Zellenhöhe schon beim ersten Rendern korrekt kennen, um die
      // "+N weitere"-Kappung richtig zu berechnen — ein nachträgliches
      // setOption('height', …) kommt dafür zu spät (mit echten
      // Testdaten nachgewiesen: Termine wurden sonst unsichtbar).
      height:          '100%',

      // Wochentag-Beschriftung auf Deutsch kürzen (Mo, Di, …)
      dayHeaderFormat: { weekday: 'short' },

      // "+N more" auf Deutsch
      moreLinkText: function (n) { return `+${n} weitere`; },

      // Raumfarbe je Termin (beliebig viele Räume/Farben statt fixer ev-room1..5-Klassen)
      eventDidMount: function (info) {
        const color = info.event.extendedProps.roomColor;
        if (color) {
          // Volle Raumfarbe als Hintergrund (vorher nur 20% Deckkraft
          // gemischt mit Weiß — stark verwässerte Darstellung, siehe
          // print-week.hbs für die ausführliche Begründung). Kein
          // border-left-Akzent mehr nötig, da er in derselben Farbe wie
          // die jetzt volle Füllung ohnehin unsichtbar wäre.
          info.el.style.backgroundColor = color;
          // Automatisch berechnete Kontrastfarbe (Schwarz/Weiß) statt
          // fixer dunkler Textfarbe — bei dunklen Raumfarben wäre der
          // Titel sonst kaum lesbar (mit echten Test-PDFs entdeckt).
          // WICHTIG: Zusätzlich zur normalen color-Eigenschaft auch die
          // CSS-Variable --fc-event-text-color setzen — FullCalendars
          // eigene interne Regel für den Titeltext verwendet diese
          // Variable direkt und würde eine reine "color"-Zuweisung auf
          // dem äußeren Element sonst überschreiben.
          const textColor = info.event.extendedProps.roomTextColor || '#1a252f';
          info.el.style.setProperty('--fc-event-text-color', textColor);
          info.el.style.color = textColor;
        }
      },
    });

    calendar.render();
  });
  </script>
</body>
</html>
